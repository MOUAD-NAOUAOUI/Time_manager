# ============================================================
# Intelligent Time Manager - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ============================================================

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_time
DB_USER=admin
DB_PASSWORD=your_secure_db_password_here

# JWT Security (Generate a secure 256-bit key)
JWT_SECRET=your_base64_or_hex_256bit_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Backend Ports
BACKEND_PORT=8080
AI_SERVICE_PORT=8000

# AI / LLM API Keys (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8000
