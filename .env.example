# ============================================================
# Intelligent Time Manager - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ============================================================

# ============================================================
# 1. DATABASE CREDENTIALS
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_time
DB_USER=admin
DB_PASSWORD=your_secure_db_password_here

# Alternative: Full JDBC URL (overrides individual DB_* vars if set)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_time?sslmode=require

# ============================================================
# 2. SECURITY & ENCRYPTION
# ============================================================
# JWT Secret Key (256-bit hex or base64)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_base64_or_hex_256bit_jwt_secret_key_here
JWT_EXPIRATION=86400000

# AES-256 Application Database Encryption Key (32-byte Base64)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=your_base64_encoded_32_byte_aes_key_here

# ============================================================
# 3. REDIS CONFIGURATION (Required for rate limiting & JWT blacklist)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD (leave empty if Redis has no auth; generate with: openssl rand -hex 32)
REDIS_PASSWORD=

# ============================================================
# 4. AI MICROSERVICE AUTHENTICATION
# ============================================================
# Internal token for backend → AI service communication
# Generate with: openssl rand -hex 64
AI_SERVICE_INTERNAL_TOKEN=your_secure_internal_token_here

# AI / LLM API Keys (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# 5. CORS & ORIGINS
# ============================================================
# Comma-separated list of allowed origins (frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# 6. BACKEND & SERVICE URLS
# ============================================================
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8000

# ============================================================
# 7. SUPABASE (Optional - only if using Supabase for auth/storage)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
